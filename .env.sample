# Copy this file to .env and fill in real values before running `docker compose up`.
# .env is gitignored - .env.sample is the tracked template.

# Hostname/IP the whole stack is reachable at from a browser (and used to build Keycloak's
# public issuer URL / redirect URIs). "localhost" only works if you browse from the same
# machine running docker compose - use the host's real hostname/IP otherwise, and also update
# every "localhost" in portal/properties.hl-docker to match.
PUBLIC_HOST=localhost

# Keycloak bootstrap admin - used only for the very first init, auto-deleted afterward.
# NOTE: this only takes effect the very first time Keycloak starts against an empty database.
# If you get this wrong on first start, you must wipe the "keycloak" Postgres database and
# restart to get another chance - see Keycloak-Notes.md issue 6.
KC_BOOTSTRAP_ADMIN_USERNAME=bootstrap-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=CHANGEME-bootstrap-password

# Keycloak permanent admin - the one to actually log into the Keycloak admin console with
KC_PERMANENT_ADMIN_USER=admin
KC_PERMANENT_ADMIN_PASSWORD=CHANGEME-permanent-admin-password
KC_PERMANENT_ADMIN_EMAIL=change.me@castsoftware.com

# OIDC / admin-API client secrets - shared between the keycloak and highlightportal services
# (see docker-compose.yml - highlightportal reads the same three values via environment vars,
# not from portal/properties.hl-docker, precisely so both sides can never drift out of sync)
KC_HL_CLIENT_SECRET=CHANGEME-portal-client-secret
KC_HL_ADMIN_SECRET=CHANGEME-admin-client-secret
KC_HL_WEBHOOK_SECRET=CHANGEME-webhook-secret

# SMTP settings
# NOTE: docker compose interpolates $VAR / ${VAR} inside .env values too - a literal "$" in
# any of these values (most likely SMTP_PASSWORD) must be written as "$$", or compose silently
# treats "$word" as a reference to an unset shell variable and blanks it out (with a
# "variable is not set" warning), corrupting the value with no hard failure.
#
# SECOND, SEPARATE ISSUE (SMTP_PASSWORD only, confirmed issue in hlkeycloak's entrypoint.sh, 1.0.3 through 1.0.6):
# Keycloak's entrypoint.sh injects SMTP_PASSWORD into a JSON realm-import template via envsubst
# with NO JSON-escaping. A literal "\" in the password produces invalid JSON ("Unrecognized
# character escape") and Keycloak fails to start entirely. If the real password contains a "\",
# write it doubled ("\\") here so the raw env var Keycloak sees already contains the JSON-valid
# escape - e.g. a true password of `foo\bar` must be written as `foo\\bar` (combined with the
# "$$" rule above if it also has a literal "$"). Report the underlying bug to the hlkeycloak
# build team - this should not be a value we have to work around.
SMTP_HOST=smtp.company.com
SMTP_PORT=587
SMTP_FROM=shared-mailer@company.com
SMTP_FROM_DISPLAY_NAME=CAST Highlight
SMTP_USER=shared-mailer@company.com
SMTP_PASSWORD=CHANGEME-smtp-password
